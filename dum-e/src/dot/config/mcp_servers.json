{
  "mcpServers": {
    "github": {
      "command": "src/dot/bin/mcp-servers/github-mcp-server.exe",
      "args": ["stdio"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "browser": {
      "command": "py",
      "args": ["-m", "src.dot.automation_mcp.browser_automation"]
    },
    "os_tools": {
      "command": "py",
      "args": ["-m", "src.dot.automation_mcp.os_automation"]
    }
  }
}
