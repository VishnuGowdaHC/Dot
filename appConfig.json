        "cpu": "llama-server.exe -m {model_file} --mmproj {mmproj_file} --port {port} -c {context_size} -np 1 -fa on -ctk q8_0 -ctv q8_0 -b 2048 -ub 1024 --temp {temperature} --alias dot-engine",
        "orchestrator": "cd backend && py -3.12 -m uvicorn server:app --port 3000",
        "frontend": "cd frontend && npx @neutralinojs/neu run"
    },
    "active_settings": {
