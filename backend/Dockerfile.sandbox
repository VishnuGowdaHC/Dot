FROM python:3.12-slim-bookworm

# Configure non-interactive apt and Python output behavior.
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    CHROME_BIN=/usr/bin/chromium \
    CHROMIUM_PATH=/usr/bin/chromium

# Install minimal system utilities and headless Chromium.
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    curl \
    git \
    procps \
    ca-certificates \
    chromium \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Install pinned Python utilities before copying application binaries.
RUN pip install --no-cache-dir \
    httpx==0.28.1 \
    playwright==1.50.0

# Create a non-root user and workspace directory.
RUN useradd -m -u 1000 -s /bin/bash sandbox \
    && mkdir -p /workspace \
    && chown -R sandbox:sandbox /workspace

# Copy the standalone browser binary with executable permissions.
COPY --chmod=755 dot/mcp/bin/agent-browser-linux-x64 /usr/local/bin/agent-browser

# Set the working directory and switch to the non-root user.
WORKDIR /workspace
USER sandbox

# Keep the container active for asynchronous commands.
CMD ["tail", "-f", "/dev/null"]
