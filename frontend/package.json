{
  "name": "dot-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "neu": "neu run",
    "build": "npm run build:css && npx @neutralinojs/neu build --release",
    "dev": "concurrently \"npm run watch:css\" \"neu run\"",
    "start": "concurrently \"npm run watch:css\" \"neu run\""
  },
  "dependencies": {
    "@neutralinojs/lib": "^6.5.0",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^9.2.1"
  }
}
